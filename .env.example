# OpenAI API Key for default model
# OPENAI_USER_KEY=your_openai_api_key_here

# Custom Model Factory path (optional)
# Uncomment and set this to use your own model factory implementation
# CUSTOM_MODEL_FACTORY=src/llm_models/custom_model_factory.py

# TEMPERATURE=0.0

# CLAUDE
# GOOGLE_APPLICATION_CREDENTIALS="/home/giacobazzi/gcp-wif-config.json"
# GOOGLE_EXTERNAL_ACCOUNT_ALLOW_EXECUTABLES="1"
# ANTHROPIC_VERTEX_PROJECT_ID=<P_NUMBER>
# ANTHROPIC_VERTEX_LOCATION=global
# DEFAULT_MODEL=claude-sonnet-4-6
# DEFAULT_MODEL=claude-3.7-sonnet
# # CLAUDE_MAX_TOKENS=8096

# AGENTS — single model setting shared by Claude Code, OpenCode, Claw Code,
# and Codex, as <provider>/<model> (LiteLLM form). The provider prefix
# picks the credentials: bedrock/ -> BEDROCK_AWS_*, vertex_ai/ -> Vertex,
# anthropic/ -> ANTHROPIC_API_KEY. Change it with: make change-model MODEL=...
# LLM_MODEL=bedrock/global.anthropic.claude-sonnet-4-6
# LLM_MODEL=vertex_ai/claude-sonnet-4-6@default

# AWS Bedrock credentials (used when LLM_MODEL starts with bedrock/; any
# Vertex credential is then withheld from the agent container)
# BEDROCK_AWS_ACCESS_KEY_ID=your_aws_access_key_id
# BEDROCK_AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
# BEDROCK_AWS_REGION_NAME=us-east-1

# Benchmark settings (defaults shown in comments)
# BENCHMARK_THREADS=1
# BENCHMARK_PREFIX=work
# DEFAULT_MODEL=gpt-4o-mini
# OPENROUTER_API_KEY=openrouter_key

# Timeout in seconds for each harness run and each agent session.
# If unset there is no timeout (a stuck container hangs forever).
DOCKER_TIMEOUT=1800

# CODEX (src/agents/codex) — uses LLM_MODEL like the other agents:
#   openrouter/<id> -> OPENROUTER_API_KEY, openai/<id> -> OPENAI_API_KEY,
#   bedrock/ or vertex_ai/ -> a Responses-compatible proxy (e.g. LiteLLM).
# CODEX_TIMEOUT_SECONDS=600
# CODEX_REASONING_EFFORT=high
# CODEX_PROXY_BASE_URL=http://<host>:4000/v1
# CODEX_PROXY_API_KEY=
# Prices in USD per 1M tokens, used to compute cost in the agent log (0 if unset)
# CODEX_PRICE_INPUT=
# CODEX_PRICE_CACHED=
# CODEX_PRICE_OUTPUT=

# EDA Tool Infrastructure Configuration
# OSS_SIM_IMAGE=osvb-cocotb:v2   (default; built with `make cocov2`)
# Set to true with the cocotb-2 datasets (CVDP v1.1.0+): their runner passes
# -timescale to xrun itself, so it isn't added again through XRUNOPTS.
# The *-v110* Makefile targets set it for you.
# NEW_HARNESS=false

# Enable LLM-based subjective scoring (defaults shown in comments)
# ENABLE_SUBJECTIVE_SCORING=false


# Email notification sent by `make` at the end of every run_benchmark target,
# via the server's local MTA (see tools/notify_email.py). Leave unset to
# disable notifications.
# NOTIFY_EMAIL_TO=s331407@studenti.polito.it

# Path to directory containing cvdp_agentic_heavy_* local git repos or .bundle files
# (from HF: cvdp_v1.1.0_agentic_heavy_code_generation_public/).
# Datapoint repo names resolve to either my_repo/ or my_repo.bundle.
# CVDP_HEAVY_REPOS_PATH=/path/to/cvdp_v1.1.0_agentic_heavy_code_generation_public
