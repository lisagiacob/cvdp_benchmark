# Extra Python packages needed by some CVDP v1.1.0 heavy agentic harnesses,
# layered on top of an existing verification image so the base tag (used by
# all the other thesis runs) stays untouched:
#   aes           cheriot-ibex_0003/0007, caliptra-rtl_0002, enso_0109,
#                 verilog_axi_0007 (imported by their harness_library.py)
#   cocotbext-axi verilog_axi_0001
# Versions pinned as in upstream's docker/requirements.txt (nvidia/cvdp-sim).
# Built by `make cocov2-heavy` / `make cadence-cocotb2-heavy`.
ARG BASE
FROM ${BASE}
ARG PKGS
RUN python3 -m pip install --no-cache-dir ${PKGS}
